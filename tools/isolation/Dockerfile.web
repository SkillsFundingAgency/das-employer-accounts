# Isolation Debug build so /service/SignIn-Stub (#if DEBUG) is available.
# Requires access to SkillsFundingAgency private NuGet feeds for SFA.DAS.* packages.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Optional: mount/copy a nuget.config with Azure Artifacts credentials at build time.
COPY nuget.config* ./
COPY src/SFA.DAS.EmployerAccounts.Messages ./SFA.DAS.EmployerAccounts.Messages/
COPY src/SFA.DAS.EmployerAccounts.Types ./SFA.DAS.EmployerAccounts.Types/
COPY src/SFA.DAS.EmployerAccounts ./SFA.DAS.EmployerAccounts/
COPY src/SFA.DAS.EmployerAccounts.Web ./SFA.DAS.EmployerAccounts.Web/

WORKDIR /src/SFA.DAS.EmployerAccounts.Web
ARG NUGET_FEED_URL=
ARG NUGET_FEED_USER=
ARG NUGET_FEED_PASS=
RUN if [ -n "$NUGET_FEED_URL" ]; then \
      dotnet nuget add source "$NUGET_FEED_URL" --name sfa-private --username "$NUGET_FEED_USER" --password "$NUGET_FEED_PASS" --store-password-in-clear-text; \
    fi
RUN dotnet restore
RUN dotnet build -c Debug --no-restore -o /app/build

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
ENV ASPNETCORE_URLS=http://+:5024
ENV ASPNETCORE_ENVIRONMENT=Development
ENV IsolationMode=true
ENV EnvironmentName=LOCAL
EXPOSE 5024
COPY --from=build /app/build .
ENTRYPOINT ["dotnet", "SFA.DAS.EmployerAccounts.Web.dll"]
