<Project Sdk="Microsoft.Build.Sql/2.3.0">
  <!-- Cross-platform DACPAC build via `dotnet build` (macOS/Linux/Windows).
       Default SQL globs pick up new Tables/Procs/Views/Functions automatically.
       Classic SFA.DAS.EmployerAccounts.Database.sqlproj remains for Visual Studio / existing CI
       (that project still needs manual Build includes). -->
  <PropertyGroup>
    <Name>SFA.DAS.EmployerAccounts.Database</Name>
    <DSP>Microsoft.Data.Tools.Schema.Sql.SqlAzureV12DatabaseSchemaProvider</DSP>
    <ModelCollation>1033, CI</ModelCollation>
    <TargetDatabaseSet>True</TargetDatabaseSet>
    <DefaultSchema>employer_account</DefaultSchema>
    <SqlServerVerification>False</SqlServerVerification>
  </PropertyGroup>
  <ItemGroup>
    <!-- Scripts are Pre/PostDeploy or one-off Manual — not model objects -->
    <Build Remove="Scripts\**\*.sql" />
    <!-- Present on disk but excluded from the classic project model (does not build cleanly) -->
    <Build Remove="StoredProcedures\EnsureAccountLegalEntity.sql" />
    <Build Remove="obj\**\*.sql" />
    <Build Remove="bin\**\*.sql" />
  </ItemGroup>
  <ItemGroup>
    <PreDeploy Include="Scripts\PreDeployment\PreDeployment.sql" />
    <PostDeploy Include="Scripts\PostDeployment\PostDeployment.sql" />
  </ItemGroup>
</Project>
