    <Build Include="Views\GetAccountPayeSchemes.sql" />
    <Build Include="Tables\LegalEntity.sql" />
    <Build Include="StoredProcedures\CreatePaye.sql" />
    <Build Include="Tables\EmployerAgreementTemplate.sql" />
